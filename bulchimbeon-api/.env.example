# App
APP_ENV=local                      # local | demo
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me
DEMO_PASSWORD=demo1234!         # ⛔ 공개 URL 에 붙는 인스턴스에서는 반드시 다른 값으로
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# DB
PIPELINE_MAX_CONCURRENCY=8      # 동시 파이프라인 상한 (03 §4.3)
DB_POOL_SIZE=10                 # ⚠️ 상한보다 넉넉해야 요청 처리용 여유가 남는다
DB_MAX_OVERFLOW=10
DATABASE_URL=postgresql+asyncpg://bulchimbeon:bulchimbeon@localhost:5432/bulchimbeon
TEST_DATABASE_URL=postgresql+asyncpg://bulchimbeon:bulchimbeon@localhost:5432/bulchimbeon_test

# LLM
LLM_PROVIDER=openai                 # openai | fake
OPENAI_API_KEY=sk-...
# 단계별 모델 배정 — 기준은 "중요도"가 아니라 **실패했을 때 회복 가능한가**다.
LLM_MODEL_ANSWER=gpt-5.6-terra           # ④ 답변 생성 — 뒤에 ⑤가 걸러 준다
LLM_MODEL_VERIFY=gpt-5.6-sol             # ⑤ 근거 검증 — 뚫리면 환각이 🟢로 발행된다
LLM_MODEL_REUSE_GATE=gpt-5.6-terra       # 재사용 판정 — 실측상 sol 과 동일 (03 §4.1.2)
LLM_MODEL_STRUCT=gpt-5.6-terra           # ⑦ 카드 구조화 — 담당자가 읽고 보정한다
LLM_MODEL_TRANSLATE=gpt-5.6-terra        # ① 질문 ko→en — ⛔ luna 로 내리지 마라 (03 §4.1.3)
                                         #    luna 는 같은 질문을 5회에 4종으로 번역해 Q8 이
                                         #    차단선 위아래로 흔들린다 → 시나리오 B 가 사라진다
LLM_MODEL_LESSON=gpt-5.6-luna            # 교훈 추출 — 배치라 지연·정확도 여유 있음
LLM_MODEL_ANSWER_TRANSLATE=gpt-5.6-terra # ⚠️ 담당자 확정문 en→ko — 아래 주석 필독
# ⚠️ ANSWER_TRANSLATE 를 TRANSLATE 와 합치지 마라. 이 번역 결과가 질문자가 읽는 확정
#    답변이고 룰 4(확정 ko 원문 재번역 금지)로 공식 Q&A에 그대로 굳는다. 담당자는 영어로
#    쓰고 질문자는 한국어를 읽으므로 오역을 잡아 줄 사람이 경로에 없다.

LLM_REASONING_EFFORT=low            # ⚠️ minimal 은 gpt-5.6 계열에서 400 (2026-08-09 실측).
                                    # 5.6 최소값이 low 이고 gpt-5-mini 도 low 를 받으므로
                                    # 두 계열 혼용이 이 값 하나로 된다. 실측 여유 충분.
LLM_TIMEOUT_SECONDS=45              # 단건 호출 타임아웃 (M-1 실측 p90 8.09s 대비 충분)
LLM_PIPELINE_DEADLINE_SECONDS=25    # 🟢/🟡 경로 데드라인 (3회 호출, M-1 실측 p90 24.3s)
LLM_PIPELINE_DEADLINE_RED_SECONDS=35  # 🔴 경로 데드라인 (4회 호출 — ⑦구조화 추가, M-1 실측 p90 32.4s)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                  # 응답 차원 검증 + dimensions 파라미터용. 벡터 컬럼은 vector(1536) 리터럴 고정

# Storage
STORAGE_DIR=/home/kancth03/bulchimbeon/bulchimbeon-api/storage    # 절대 경로 필수 (호스트/컨테이너 혼선 방지)

# Integrations (프로젝트별 토큰은 DB 암호화 저장, 여긴 암호화 키만)
INTEGRATION_ENCRYPTION_KEY=change-me-32bytes
